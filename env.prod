SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
PIP_CERT=/etc/ssl/certs/ca-certificates.crt
# UI telemetry proxy. A full SIGNAL PATH, correct for the browser which POSTs
# to it directly. NOT reusable by the SDK exporter — see below.
OTEL_PROXY_ENDPOINT=http://otel-collector:4318/v1/traces
# Server tracing (STABL-qnlaclof). BASE endpoint, no signal path: the SDK
# exporter is handed OTEL_EXPORTER_OTLP_ENDPOINT + /v1/traces by
# server/tracing.py:_traces_endpoint(). Putting the full path here yields
# /v1/traces/v1/traces.
TRACING_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
REDIS_URL=redis://node1.lan:6379/0
REDIS_PREFIX=lcm
REDIS_SOCKET_TIMEOUT=2
REDIS_CONNECT_TIMEOUT=2
LOG_REQUESTS=1
LOG_REQUEST_HEADERS=1
LOG_REQUEST_BODY=1
LOG_BODY_MAX=8192
export LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_HEADER_ALLOWLIST="content-type,content-length,x-forwarded-for,x-real-ip,user-agent,host"
LOG_PATH_PREFIXES="/generate,/superres,/sdapi"
PORT=4200
NUM_WORKERS=1
QUEUE_MAX=8
SR_NUM_WORKERS=1
SR_QUEUE_MAX=8
SR_ENABLED=1
STORAGE_PROVIDER=FILESYSTEM
ASSET_STORE_PROVIDER=FILESYSTEM
FS_STORAGE_DIR=/store
FS_STORAGE_TTL_S=604800
FS_STORAGE_CLEANUP_INTERVAL_S=3600
STORAGE_ENABLE_HTTP=1
MODE_CONFIG_PATH=/conf
CUI_WORKFLOWS_PATH=/workflows
export DEBUG_FULL_PAYLOAD=1
UI_DIST=true
